{
  "name": "@upkeep/dashboard",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./bundle": "./bundle.ts"
  },
  "scripts": {
    "build": "rm -rf ${DASHBOARD_OUT:-dist} && bun build index.html --outdir ${DASHBOARD_OUT:-dist} --production --define \"process.env.UPKEEP_BUILD_VERSION='${UPKEEP_BUILD_VERSION:-dev}'\" && bun scripts/inline-boot.ts && bun scripts/pwa.ts",
    "icons": "bun scripts/icons.ts",
    "test": "bun test --pass-with-no-tests",
    "lint": "oxlint .",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.5",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@tanstack/lit-virtual": "3.15.5",
    "@timmo001/groundwork-pwa": "0.51.1",
    "@timmo001/groundwork-tokens": "0.51.1",
    "@timmo001/groundwork-ui": "0.51.1",
    "@upkeep/api": "workspace:*",
    "cronstrue": "3.43.0",
    "effect": "4.1.5",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.4",
    "@oxlint/plugins": "1.94.0",
    "@phosphor-icons/core": "2.1.1",
    "@timmo001/oxlint-rules": "0.7.1",
    "@types/bun": "1.4.5",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "svgpath": "2.6.0",
    "typescript": "7.0.2"
  }
}
