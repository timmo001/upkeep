{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/repos/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/dotfiles*/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/dot/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/groundwork/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.agents/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.local/share/dot/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.local/share/opencode/repos/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.cache/agent-scratch/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/opencode/**",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "~/repos/**",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "~/repos/upkeep/**",
      "effect": "allow"
    },
    {
      "action": "gh.write *",
      "resource": "gh_issue_* timmo001/*",
      "effect": "allow"
    },
    {
      "action": "gh.write *",
      "resource": "gh_pr_* timmo001/*",
      "effect": "allow"
    },
    {
      "action": "gh.write *",
      "resource": "gh_comment_edit timmo001/*",
      "effect": "allow"
    },
    {
      "action": "gh.write *",
      "resource": "gh_review_thread_* timmo001/*",
      "effect": "allow"
    },
    {
      "action": "gh.write *",
      "resource": "gh_discussion_comment timmo001/*",
      "effect": "allow"
    },
    {
      "action": "gh.write *",
      "resource": "gh_label_create timmo001/*",
      "effect": "allow"
    },
    {
      "action": "gh.write *",
      "resource": "gh_run_* timmo001/*",
      "effect": "allow"
    },
    {
      "action": "gh.write *",
      "resource": "gh_workflow_dispatch timmo001/*",
      "effect": "allow"
    },
    {
      "action": "gh.write *",
      "resource": "gh_upload_attachment*",
      "effect": "allow"
    },
    {
      "action": "gh.write *",
      "resource": "gh_api POST *",
      "effect": "allow"
    },
    {
      "action": "gh.write *",
      "resource": "gh_api PATCH *",
      "effect": "allow"
    },
    {
      "action": "gh.write *",
      "resource": "gh_api PUT *",
      "effect": "allow"
    },
    {
      "action": "gh.write *",
      "resource": "gh_graphql mutation *",
      "effect": "allow"
    },
    {
      "action": "gh.write *",
      "resource": "gh_issue_artifact_delete *",
      "effect": "ask"
    },
    {
      "action": "gh.write *",
      "resource": "gh_graphql mutation *delete*",
      "effect": "ask"
    }
  ]
}
