{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/repos/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/dotfiles*/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.cache/agent-scratch/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/opencode/**",
      "effect": "allow"
    },
    {
      "action": "gh.write *",
      "resource": "gh_* timmo001/upkeep*",
      "effect": "allow"
    },
    {
      "action": "gh.write *",
      "resource": "gh_* timmo001/groundwork*",
      "effect": "allow"
    },
    {
      "action": "gh.write *",
      "resource": "gh_*delete* timmo001/upkeep*",
      "effect": "ask"
    },
    {
      "action": "gh.write *",
      "resource": "gh_*delete* timmo001/groundwork*",
      "effect": "ask"
    }
  ]
}
