{
  "name": "upkeep",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.10"
  },
  "overrides": {
    "@timmo001/effect-herdr": {
      "effect": "4.1.3",
      "@effect/platform-node-shared": "4.1.3"
    }
  },
  "trustedDependencies": [
    "rs-module-lexer",
    "sharp",
    "workerd"
  ]
}
